########################################################################
# Shared environment file — loaded by every service in docker-compose.yml
# Copy to `.env` (already done) and edit values before first run.
########################################################################

SUPER_ADMIN=
ENV=development

# ---- Project / Compose ----
COMPOSE_PROJECT_NAME=devstack

# ---- Networking ----
NETWORK_NAME=devstack_net
NETWORK_SUBNET=172.28.0.0/16

# ---- Linux desktop machine ----
LINUX_HOSTNAME=devbox
DESKTOP_USER=dev
DESKTOP_PASSWORD=changeme123
DESKTOP_UID=1000
DESKTOP_GID=1000

# GitHub CLI (gh) — authenticates `gh` and git push/pull on every
# container start (see entrypoint.sh). Leave GH_TOKEN blank to skip
# auth entirely (gh/git just won't be pre-authenticated). Use a
# fine-grained or classic Personal Access Token, not your password —
# create one at https://github.com/settings/tokens
GH_USERNAME=
GH_TOKEN=
GH_EMAIL=

# VNC
VNC_PASSWORD=changeme123
VNC_RESOLUTION=1920x1080
VNC_COL_DEPTH=24
LINUX_VNC_PORT=5901        # host port -> raw VNC client access
LINUX_NOVNC_PORT=6901      # host port -> browser access (http://localhost:6901/vnc.html)

# GPU
# Set to "true" only if the host has NVIDIA drivers + the NVIDIA Container
# Toolkit installed. See linux/README section in the top-level README.md.
ENABLE_GPU=false

# ---- MySQL — reachable by every container on the network at host "mysql" ----
MYSQL_ROOT_PASSWORD=changeme
MYSQL_DATABASE=app
MYSQL_USER=app
MYSQL_PASSWORD=changeme
MYSQL_PORT=3322

# phpMyAdmin — host port for http://localhost:<port>
PHPMYADMIN_PORT=8081
# Connection string for apps in linux/php or node to use directly.
# NOT auto-derived from the MYSQL_* values above — if you change those,
# update these to match.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=${MYSQL_DATABASE}
DB_USERNAME=${MYSQL_USER}
DB_PASSWORD=${MYSQL_PASSWORD}
DATABASE_URL=mysql://${MYSQL_USER}:${MYSQL_PASSWORD}@mysql:3306ap


# Connection string for apps in linux/php or node to use directly.
# NOT auto-derived from the MYSQL_* values above — if you change those,
# update these to match.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=${MYSQL_PORT}
DB_DATABASE=app
DB_USERNAME=app
DB_PASSWORD=changeme
DATABASE_URL=mysql://app:changeme@mysql:${MYSQL_PORT}/app

# ---- Redis (placeholder) ----
REDIS_PORT=6379

# ---- Node (placeholder) ----
NODE_PORT=3000
NODE_ENV=${ENV}

# ---- Nginx ----
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# MongoDB
MONGO_PORT=27017
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=changeme
MONGO_DATABASE=app
MONGO_USER=app
MONGO_PASSWORD=changeme
MONGODB_URI=mongodb://app:changeme@mongo:27017/app?authSource=app
MONGO_EXPRESS_PORT=8082

# ---- Shared paths (relative to project root) ----
SITES_PATH=./sites
SITES_JSON_PATH=./sites.json
DATA_PATH=./data
LOGS_PATH=./logs
MYSQL_PATH=./mysql
