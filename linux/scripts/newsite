#!/bin/bash
TAG="[site] "
VERSION="1.0.0"
txtblk=$'\033[0;30m' # Black - Regular
txtred=$'\033[0;31m' # Red
txtgrn=$'\033[0;32m' # Green
txtylw=$'\033[0;33m' # Yellow
txtblu=$'\033[0;34m' # Blue
txtpur=$'\033[0;35m' # Purple
txtcyn=$'\033[0;36m' # Cyan
txtwht=$'\033[0;37m' # White
bldblk=$'\033[1;30m' # Black - Bold
bldred=$'\033[1;31m' # Red
bldgrn=$'\033[1;32m' # Green
bldylw=$'\033[1;33m' # Yellow
bldblu=$'\033[1;34m' # Blue
bldpur=$'\033[1;35m' # Purple
bldcyn=$'\033[1;36m' # Cyan
bldwht=$'\033[1;37m' # White
unkblk=$'\033[4;30m' # Black - Underline
undred=$'\033[4;31m' # Red
undgrn=$'\033[4;32m' # Green
undylw=$'\033[4;33m' # Yellow
undblu=$'\033[4;34m' # Blue
undpur=$'\033[4;35m' # Purple
undcyn=$'\033[4;36m' # Cyan
undwht=$'\033[4;37m' # White
bakblk=$'\033[40m'   # Black - Background
bakred=$'\033[41m'   # Red
bakgrn=$'\033[42m'   # Green
bakylw=$'\033[43m'   # Yellow
bakblu=$'\033[44m'   # Blue
bakpur=$'\033[45m'   # Purple
bakcyn=$'\033[46m'   # Cyan
bakwht=$'\033[47m'   # White
txtrst=$'\033[0m'    # Text Reset
g1=$'\033[38;5;248m'
g2=$'\033[38;5;249m'
g3=$'\033[38;5;250m'
g4=$'\033[38;5;251m'
dblline="${g1}=============================================${txtrst}"

clear

printf "\n${bakcyn}${bldwht}╔════════════════════════════════════════╗
║                                        ╚══════*
║   __        ______    ____             ____**
║   \ \      / /  _ \  |  _ \  _____   _| __ )  _____  __
║    \ \ /\ / /| |_) | | | | |/ _ \ \ / /  _ \ / _ \ \/ /
║     \ V  V / |  __/  | |_| |  __/\ V /| |_) | (_) >  < 
║      \_/\_/  |_|     |____/ \___| \_/ |____/ \___/_/\_\\
║                                        //══════════*
║             Version ${VERSION}              ║
╚════════════════════════════════════════╝
${txtrst}"
echo "New Site Setup"

DB_NAME="wp_composerwp4"
DB_USER="composerwp4"
DB_HOST="mysql"
HOST_NAME="localhost"
DB_PASS="changeme"
SITE_URL="composerwp4.local"
SITE_NAME="composer single site4"
ADMIN_PASS="password"
DIR="/var/www/composerwp4/"


####################################################################
# Project files setup #
####################################################################
echo ""
echo $dblline;
echo "Checking directory..."
if [ ! -d "$DIR" ]; then
  mkdir -p "$DIR"
  echo "  * Project Directory created: ${bldgrn}$DIR${txtrst}."
else
  echo "  * ${bldred}$DIR${txtrst} already exists. Check settings and re-run."
  echo "Exiting"
  exit 1;
fi
echo "============================================="
echo ""

####################################################################
# database setup #
####################################################################
echo "============================================="
echo "Setting up database and user..."
export MYSQL_PWD=$MYSQL_PASSWORD
if mysql -h mysql -u root -e "SELECT user FROM mysql.user WHERE user='$DB_USER'" | grep -q "$DB_USER"; then
    echo "  * User '$DB_USER' exists - Skipping database set up."
else
    echo "  * User '$DB_USER' does not exist."
	echo "    * Creating MySQL database and user..."
	mysql -h mysql -u root <<EOF
	CREATE DATABASE IF NOT EXISTS $DB_NAME;
	CREATE USER '$DB_USER'@'%' IDENTIFIED BY '$DB_PASS';
	GRANT ALL PRIVILEGES ON \`$DB_NAME\`.* TO '$DB_USER'@'%';
	FLUSH PRIVILEGES;
EOF
	echo "  * Success! User ${bldgrn}$DB_USER${txtrst} has been created for ${bldgrn}$DB_NAME${txtrst}."
fi

unset MYSQL_PWD
echo "Database ready."
echo "============================================="

####################################################################
# composer project pull, install and setup #
####################################################################
echo ""
echo "============================================="
echo "Creating and setting up project files"
git init $DIR
cd $DIR
git branch -m main
git remote add upstream http://github.com/flatline01/composerwp
git pull upstream main
git status
composer install
npm init -y --silent

echo "============================================="

####################################################################
# Wordpress setup #
####################################################################
echo ""
echo "============================================="
echo "Installing standard WordPress site..."
echo ""
echo "---------------------------------------------"
# create env
echo "  * Creating env file..."

cat << EOF >  env.php
<?php
#generated by WPDevBox
#${VERSION}
#created: $(date)
#phpinfo();

define( 'DB_HOST',getenv('DB_HOST') );

if( null !== getenv('ENV') && getenv('ENV') === "development"){
	//dev enviroment
	define( 'DB_NAME', '${DB_NAME}' );
	define( 'DB_USER', '${DB_USER}' );
	define( 'DB_PASSWORD', '${DB_PASS}' );
	define( 'WP_DEBUG', true );

	// Save errors to the /wp-content/debug.log file
	define( 'WP_DEBUG_LOG', '/var/log/devstack/${DB_NAME}-errors.log' );
	define( 'WP_DEBUG_DISPLAY', true );
	@ini_set( 'display_errors', 0 );
}
else{
	//prod
	define( 'DB_NAME', getenv('DB_TENANT_NAME') );
	define( 'DB_USER', getenv('DB_TENANT_USER') );
	define( 'DB_PASSWORD', getenv('DB_TENANT_PASSWORD') );
	
	define( 'WP_DEBUG', false );
}

EOF

echo "   * ${txtgrn}Success! Env has been created.${txtrst} "
echo "  Generating Salts"
# get new salts
curl -s https://api.wordpress.org/secret-key/1.1/salt/ >> env.php
echo "   * ${txtgrn}Success! Salts have been created.${txtrst} "
echo "---------------------------------------------"
echo ""
echo "---------------------------------------------"
echo "  Pulling and installing ComposerWP project..."

echo "   * ${txtgrn}Success! Composer install complete.${txtrst} "
echo "---------------------------------------------"
echo ""
echo "---------------------------------------------"
echo "  * Installing Wordpress..."
# install wordpress
if [ "\$MULTISITE" = true ]; then
    echo "    * Installing WordPress as a Multisite Network..."
    # Installs core network setup directly
    wp core multisite-install \
		--url="$SITE_URL" \
		--title="$SITE_NAME" \
		--admin_user="$SUPER_ADMIN" \
		--admin_password="$ADMIN_PASS" \
		--admin_email="$SUPER_ADMIN" \
		--skip-email \
        --subdomains=false # Set to true if you are doing a subdomain network instead of subdirectories
		wp super-admin add $SUPER_ADMIN
else
    echo "    * Installing standard WordPress site..."
    wp core install \
		--url="$SITE_URL" \
		--title="$SITE_NAME" \
		--admin_user="$SUPER_ADMIN" \
		--admin_password="$ADMIN_PASS" \
		--admin_email="$SUPER_ADMIN" \
		--skip-email
fi


echo "   * ${txtgrn}Success! Wordpress has been installed.${txtrst} "
echo "---------------------------------------------"
echo "============================================="

####################################################################
# bootstrap server #
####################################################################
# update sites.json. nginx should provision and restart



# ask user if they want to set up a new site
# get site name and tld
# loop through sites.json and the folders in /var/www and make sure it doesnt already exist
# if exists, exit
# else ask what kind of project - wordpress single, wordpress multi, node
# if wordpress
#   mysql root create new user - done
#   mysql create scheama - done
#   pull composewp project
#   composer install
#   npm init done
#   git init done
#   wp cli
#      create user from 
#      multisite? set superadmin
#      install MU plugins
#         graphql
#         querymonitor
#   create wp-config 
#   create env.php
#   wp config create --dbname=<dbname> --dbuser=<dbuser> --dbpass=<dbpass> --dbhost=<dbhost> --dbprefix=<dbprefix> --config-file=<path>
#   wp core install --url=http://example.com --title="My Site" --admin_user=admin --admin_password=secure_password --admin_email=admin@example.com
#   
#   
# update sites.json

